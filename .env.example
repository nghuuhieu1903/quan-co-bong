DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/dbname
SECRET_KEY=change-this-to-a-long-random-string

# Optional: only needed for the Super Admin "forgot password" email flow.
# Gmail requires an App Password (not your normal Gmail password) - create
# one at https://myaccount.google.com/apppasswords with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SUPER_ADMIN_RECOVERY_EMAIL=hhieu193@gmail.com
